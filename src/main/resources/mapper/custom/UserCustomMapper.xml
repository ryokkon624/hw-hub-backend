<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hwhub.backend.infrastructure.mybatis.custom.mapper.UserCustomMapper">

    <select id="findPasswordChangedAt" resultType="java.time.LocalDateTime">
        SELECT password_changed_at
        FROM m_user
        WHERE user_id = #{userId}
    </select>

</mapper>
