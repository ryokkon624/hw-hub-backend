<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hwhub.backend.infrastructure.mybatis.custom.mapper.UserRoleCustomMapper">

  <select id="findByUserId" resultMap="com.hwhub.backend.infrastructure.mybatis.generated.mapper.MUserRoleMapper.BaseResultMap">
    SELECT * FROM m_user_role
    WHERE user_id = #{userId}
  </select>

  <!-- 物理削除 -->
  <delete id="softDelete">
    DELETE FROM m_user_role
    WHERE user_id = #{userId} AND role = #{role}
  </delete>

  <select id="exists" resultType="boolean">
    SELECT COUNT(*) > 0 FROM m_user_role
    WHERE user_id = #{userId} AND role = #{role}
  </select>

  <!-- m_role_permission からロールに紐づくパーミッションを取得 -->
  <select id="findPermissionsByRoles" resultType="string">
    SELECT DISTINCT permission
    FROM m_role_permission
    WHERE role IN
    <foreach item="role" collection="roles" open="(" separator="," close=")">
      #{role}
    </foreach>
  </select>

</mapper>
